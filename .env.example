# N-ATLaS playground -- example configuration.
# Copy this file to ".env" for local use and fill in your values:
#   Copy-Item .env.example .env   (PowerShell)
# The app loads ".env" automatically at startup (no python-dotenv needed), and
# real environment variables / Spaces "Variables" always take precedence.
# ".env" is never committed (already ignored by .gitignore). NEVER put real
# secrets in .env.example -- leave the values blank here.

# ---- Required: choose backend ----
# real | mock   (anything other than "real" resolves to mock)
NATLAS_MODE=mock

# ---- Real mode (only used when NATLAS_MODE=real) ----
# Primary route: your own N-ATLaS deployment. Either a TGI URL (auto-appends
# /generate) or an OpenAI-compatible URL (auto-appends /chat/completions).
# Leave blank to fall back to the secondary Hugging Face route below.
NATLAS_ENDPOINT=

# Secondary route: Hugging Face InferenceClient(model=NCAIR1/N-ATLaS). Needs a
# token from an account that has been granted access to the gated model.
HF_TOKEN=

# Model id (informational; NCAIR1/N-ATLaS is the default used everywhere).
NATLAS_MODEL_ID=NCAIR1/N-ATLaS

# Optional tuning:
NATLAS_TIMEOUT_S=60
NATLAS_RETRIES=2

# ---- Gradio server ----
# On Hugging Face Spaces these are set for you; locally they default to
# 127.0.0.1:7860.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
